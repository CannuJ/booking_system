{
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "dist",

		"module": "ESNext",
		"moduleResolution": "Bundler",
		"target": "ES2022",

		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,

		"sourceMap": true,
		"declaration": false,
		"declarationMap": false,

		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true
	},
	"include": ["src"]
}
